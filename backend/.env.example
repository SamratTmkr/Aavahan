NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_NAME=aavahan
DB_USER=aavahan_user
DB_PASSWORD=aavahan_pass

JWT_SECRET=change_me_to_something_secret
JWT_EXPIRES_IN=7d

PORT=3000

# Email notifications (Mailtrap sandbox - captures mail instead of delivering it).
# Leave blank to disable email; the app logs and carries on.
MAILTRAP_TOKEN=
MAILTRAP_INBOX_ID=
MAIL_FROM=no-reply@aavahan.test
MAIL_FROM_NAME=Aavahan
